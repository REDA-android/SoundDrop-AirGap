export component SoundDropWindow inherits Window {
    title: "Sound Drop Native — Air-Gapped Acoustic System (Zero-Web)";
    preferred-width: 960px;
    preferred-height: 680px;
    background: #060709; // Kinetics Colorion deep obsidian slate

    in-out property <string> device-state: "STANDBY";
    in-out property <float> snr-db: 22.4;
    in-out property <float> doppler-shift: 0.0;
    in-out property <float> tof-distance: 0.42;
    in-out property <bool> data-diode-active: false;
    in-out property <string> active-band: "AUDIBLE";
    in-out property <string> mascot-face: "•ᴗ•";
    in-out property <string> mascot-title: "ACOUSTIC STANDBY";
    in-out property <float> bubble-scale: 1.0;
    in-out property <float> ring-expansion-1: 0.0;
    in-out property <float> ring-expansion-2: 0.0;

    callback emit-pairing-ping();
    callback hold-emit-pressed();
    callback hold-emit-released();
    callback toggle-data-diode();
    callback switch-band(string);

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // =====================================================================
        // 1. TOP NAVIGATION & METALFORGE SECURITY STATUS BAR
        // =====================================================================
        Rectangle {
            height: 56px;
            background: #0f131a;
            border-radius: 14px;
            border-width: 0.5px;
            border-color: #ffffff2e; // Metalforge Zenithal Inner Bevel (0.18 alpha)

            // Bottom Groove Etched Shadow
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #000000a6; // 0.65 alpha
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "SOUND DROP NATIVE";
                        font-size: 15px;
                        font-weight: 900;
                        color: #f8fafc;
                        letter-spacing: 1.5px;
                    }
                    Text {
                        text: "Hairline Sub-Pixel • Kinetics Colorion • Metalforge Titanium • Page-Mascot";
                        font-size: 10px;
                        color: #64748b;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;

                    // Band Switcher (Audible vs Ultrasonic)
                    Rectangle {
                        width: 140px;
                        height: 34px;
                        background: #18202f;
                        border-width: 0.5px;
                        border-color: #3b82f640;
                        border-radius: 8px;

                        TouchArea {
                            clicked => {
                                root.switch-band(root.active-band == "AUDIBLE" ? "ULTRASONIC" : "AUDIBLE");
                            }
                        }

                        Text {
                            text: "BAND: " + root.active-band;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.active-band == "ULTRASONIC" ? #c084fc : #38bdf8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Hardware Air-Gap Data Diode Toggle
                    Rectangle {
                        width: 190px;
                        height: 34px;
                        background: root.data-diode-active ? #4c0519 : #111827;
                        border-width: 0.5px;
                        border-color: root.data-diode-active ? #f43f5e : #374151;
                        border-radius: 8px;

                        TouchArea {
                            clicked => { root.toggle-data-diode(); }
                        }

                        Text {
                            text: root.data-diode-active ? "DIODE: RX-ONLY (LOCKED)" : "DIODE: BIDIRECTIONAL";
                            font-size: 11px;
                            font-weight: 700;
                            color: root.data-diode-active ? #fda4af : #9ca3af;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // =====================================================================
        // 2. CENTRAL KINETICS COLORION & RADAR BUBBLE STAGE
        // =====================================================================
        Rectangle {
            background: #090c13;
            border-width: 0.5px;
            border-color: #ffffff20;
            border-radius: 24px;
            clip: true;

            // Concentric Ambient Acoustic Rings
            Rectangle {
                width: 320px;
                height: 320px;
                border-width: 0.5px;
                border-color: #38bdf818;
                border-radius: 160px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            Rectangle {
                width: 480px;
                height: 480px;
                border-width: 0.5px;
                border-color: #38bdf80a;
                border-radius: 240px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            // Expanding Shockwave Micro-Rings from Acoustic Explosion
            if root.ring-expansion-1 > 0.0 : Rectangle {
                width: 180px + root.ring-expansion-1 * 2.0;
                height: 180px + root.ring-expansion-1 * 2.0;
                border-radius: self.width / 2;
                border-width: 0.5px;
                border-color: #00F5D480;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            // Central Metallic Physics Bubble (Hold-to-Emit / Explosive Release)
            Rectangle {
                width: 180px * root.bubble-scale;
                height: 180px * root.bubble-scale;
                border-radius: (180px * root.bubble-scale) / 2;
                background: root.device-state == "TRANSMITTING" ? #083344 : #161c28;
                border-width: 0.5px;
                border-color: root.device-state == "TRANSMITTING" ? #00F5D4 : #ffffff30;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                TouchArea {
                    clicked => { root.emit-pairing-ping(); }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    // Central Morphicon Status Icon
                    Text {
                        text: root.device-state == "TRANSMITTING" ? "◎" : "◈";
                        font-size: 28px;
                        color: root.device-state == "TRANSMITTING" ? #00F5D4 : #38bdf8;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.device-state == "TRANSMITTING" ? "BURST EMITTING" : "TAP / HOLD TO EMIT";
                        font-size: 12px;
                        font-weight: 800;
                        color: root.device-state == "TRANSMITTING" ? #67e8f9 : #f8fafc;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "LFM 1.2-4.8 kHz • ToF Challenge";
                        font-size: 9px;
                        color: #94a3b8;
                        horizontal-alignment: center;
                    }
                }
            }

            // =================================================================
            // 3. PAGE-MASCOT NATIVE COMPANION RUNTIME
            // =================================================================
            Rectangle {
                width: 160px;
                height: 130px;
                x: parent.width - 180px;
                y: parent.height - 150px;
                background: #0d121c;
                border-radius: 16px;
                border-width: 0.5px;
                border-color: #ffffff20;

                VerticalLayout {
                    padding: 10px;
                    alignment: center;
                    spacing: 8px;

                    // Mascot Vector Face Pod
                    Rectangle {
                        width: 58px;
                        height: 58px;
                        border-radius: 20px;
                        background: root.snr-db < 10.0 ? #450a0a : (root.device-state == "TRANSMITTING" ? #042f2e : #141e33);
                        border-width: 0.5px;
                        border-color: root.snr-db < 10.0 ? #ef4444 : #00F5D4;

                        Text {
                            text: root.mascot-face;
                            font-size: 22px;
                            font-weight: 900;
                            color: root.snr-db < 10.0 ? #fca5a5 : (root.device-state == "TRANSMITTING" ? #00F5D4 : #38bdf8);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.mascot-title;
                        font-size: 9px;
                        font-weight: 800;
                        color: root.snr-db < 10.0 ? #f87171 : #94a3b8;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // =====================================================================
        // 4. LIVE TELEMETRY & PHYSICAL CO-PRESENCE STATUS
        // =====================================================================
        HorizontalLayout {
            height: 52px;
            spacing: 14px;

            Rectangle {
                background: #0d121c;
                border-width: 0.5px;
                border-color: #1e293b;
                border-radius: 12px;
                Text {
                    text: "SNR: " + Math.round(root.snr-db) + " dB (KINETICS POLE 1)";
                    color: root.snr-db > 18.0 ? #00F5D4 : (root.snr-db > 10.0 ? #fbbf24 : #f87171);
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                background: #0d121c;
                border-width: 0.5px;
                border-color: #1e293b;
                border-radius: 12px;
                Text {
                    text: "DOPPLER Δf: " + Math.round(root.doppler-shift) + " Hz (POLE 2)";
                    color: #38bdf8;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                background: #0d121c;
                border-width: 0.5px;
                border-color: #1e293b;
                border-radius: 12px;
                Text {
                    text: "ToF DISTANCE: " + root.tof-distance + " m (TARGET < 1.50m)";
                    color: root.tof-distance <= 1.50 ? #00F5D4 : #ef4444;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
